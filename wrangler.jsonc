// Hosting for the Flutter web demo (Cloudflare Workers static assets).
// Deploy: flutter build web --release && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globly",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "build/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "globly.dagnis.my.id", "custom_domain": true }
  ],
  // The default *.workers.dev address isn't needed; the site lives on the custom domain.
  "workers_dev": false
}
